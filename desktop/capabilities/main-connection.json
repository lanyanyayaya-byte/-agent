    "allow-mcp-connect-server",
    "allow-mcp-disconnect-server",
    "allow-mcp-refresh-tools",
    "allow-mcp-set-server-enabled",
    "allow-mcp-set-tool-permission",
    "allow-select-and-import-workspace-file",
    "allow-select-and-import-workspace-files",
    "allow-import-dropped-workspace-files",
    "allow-delete-workspace-file",
    "allow-open-artifact",
    "allow-reveal-artifact-in-finder",
